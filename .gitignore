# =========================================================================
# Root-level configurations (applies to all sub-folders)
# =========================================================================
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://java.com
hs_err_pid*
replay_pid*

# OS specific files
.DS_Store
Thumbless.db

